# --- Core ---
ANTHROPIC_API_KEY=
# Same key under another name, for Claude Code cloud sessions (they don't pass ANTHROPIC_* through)
# PLANNER_ANTHROPIC_API_KEY=
# Model for the agent loop and LLM helpers (claude-sonnet-5-5 costs about half)
CLAUDE_MODEL=claude-opus-5-5
# Where SQLite, the WhatsApp session and browser logins live
DATA_DIR=./data
TZ=Asia/Tokyo

# --- WhatsApp (Baileys, linked device) ---
# 1 = link to your own WhatsApp (no extra SIM; bot messages show as you with a 🤖 prefix)
# 0 = link to a separate number that's in the group
WA_SELF_MODE=1
# Chat the bot lives in: "self" = your own "Message yourself" chat (private testing),
# or a group JID like 1203630xxxxxxxx@g.us (logged on startup for every group you are in)
WA_GROUP_JID=
# 1 = solo test: every message in the chat is for the bot (use with a group that has only you in it).
# Otherwise the bot answers inline replies to its messages, "planner", or (own number) an @mention,
# and only listens to everything else.
WA_SOLO=0
# The bot's name in the group (its WhatsApp profile name); saying it (or "planner") addresses the bot
WA_BOT_NAME=Planner
# Phone numbers (country code, digits only) used to map senders to people
ADVAIT_PHONE=
# Set to warn or debug to see the WhatsApp library's own logs (hidden by default)
# WA_LOG_LEVEL=warn
EMILY_PHONE=

# --- Google ---
# Places API (New) + Routes API key
GOOGLE_MAPS_API_KEY=

# --- Booking ---
# Contact details put on reservations (Japanese name first in Japanese text)
BOOKING_NAME=
BOOKING_NAME_KANA=
# Domestic format, e.g. 070-1234-5678 (converted to +81 for English text)
BOOKING_PHONE=
BOOKING_EMAIL=
# Optional. TableCheck books as a guest without these. For a Google-login account
# use `npm run browser-login -- tablecheck` instead of a password.
TABLECHECK_EMAIL=
TABLECHECK_PASSWORD=

# --- AI phone calls (Vapi, vapi.ai) ---
# For places without TableCheck. Needs a Twilio number imported into Vapi
# (Vapi's free numbers only call the US). See docs/SETUP.md, "AI phone calls".
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Optional: model for the call conversation (Vapi's list) and an ElevenLabs voice id
VAPI_MODEL=claude-sonnet-5
VAPI_VOICE_ID=sarah
# Optional: lets the bot check your Twilio balance and errors, and tell you in plain words
# why a call failed (Twilio Console home page → Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Language the AI caller speaks in dry runs: en or ja. Real restaurant calls are always Japanese.
CALL_LANGUAGE=ja
# Dry run only: who plays the restaurant. Emily / Advait (uses EMILY_PHONE / ADVAIT_PHONE)
# or a number. Empty = BOOKING_PHONE (you). Twilio trial accounts can only call verified numbers.
CALL_TEST_TO=
# Name phone bookings go under (short, easy to write in katakana). Booking sites use BOOKING_NAME.
CALL_BOOKING_NAME=Emily
CALL_BOOKING_NAME_KANA=エミリー
# Optional: only use these booking channels (tablecheck,phone).
# BOOKING_ONLY=phone with DRY_RUN=1 = every booking from WhatsApp becomes an AI call to you.
BOOKING_ONLY=

# Google Cloud VM only: send log lines to Cloud Logging so Claude can read them (0 = off). See SETUP §10.
# CLOUD_LOGGING=1

# 1 = never press the final confirm button, and calls go to BOOKING_PHONE (you)
# instead of the restaurant
DRY_RUN=1
