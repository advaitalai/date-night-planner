# --- Core ---
ANTHROPIC_API_KEY=
# Model for the agent loop and LLM helpers
CLAUDE_MODEL=claude-opus-5-5
# Where SQLite, the WhatsApp session and browser profiles live (Fly volume mount)
DATA_DIR=./data
TZ=Asia/Tokyo

# --- WhatsApp (Baileys, spare number) ---
# Group JID the bot listens to, e.g. 1203630xxxxxxxx@g.us (logged on startup for every group the bot is in)
WA_GROUP_JID=
# Phone numbers (country code, digits only) used to map senders to people
ADVAIT_PHONE=
EMILY_PHONE=

# --- Google ---
# Places API (New) + Routes API key
GOOGLE_MAPS_API_KEY=
# OAuth client (web application) for Gmail + Drive onboarding
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public base URL of this server, e.g. https://date-night-planner.fly.dev
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

# --- Booking ---
# Contact details put on reservations
BOOKING_NAME=
BOOKING_NAME_KANA=
BOOKING_PHONE=
BOOKING_EMAIL=
# Platform logins used by the browser automation
TABLECHECK_EMAIL=
TABLECHECK_PASSWORD=
TABELOG_EMAIL=
TABELOG_PASSWORD=

# 1 = never press the final confirm button / emails go to BOOKING_EMAIL instead of the restaurant
DRY_RUN=1
