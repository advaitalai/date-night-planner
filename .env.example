# --- Core ---
ANTHROPIC_API_KEY=
# Model for the agent loop and LLM helpers (claude-sonnet-5-5 costs about half)
CLAUDE_MODEL=claude-opus-5-5
# Where SQLite, the WhatsApp session and browser logins live
DATA_DIR=./data
TZ=Asia/Tokyo

# --- WhatsApp (Baileys, linked device) ---
# 1 = link to your own WhatsApp (no extra SIM; bot messages show as you with a 🤖 prefix)
# 0 = link to a separate number that's in the group
WA_SELF_MODE=1
# Chat the bot lives in: "self" = your own "Message yourself" chat (private testing),
# or a group JID like 1203630xxxxxxxx@g.us (logged on startup for every group you are in)
WA_GROUP_JID=
# 1 = solo test: only Advait votes and every message in the chat is for the bot
# (use with a WhatsApp group that has only you in it)
WA_SOLO=0
# Phone numbers (country code, digits only) used to map senders to people
ADVAIT_PHONE=
EMILY_PHONE=

# --- Google ---
# Places API (New) + Routes API key
GOOGLE_MAPS_API_KEY=
# OAuth client (web application) for Gmail + Drive onboarding
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Base URL for the onboarding page / OAuth redirect. On the Google Cloud VM keep
# localhost and open it through an SSH tunnel (see README).
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

# --- Booking ---
# Contact details put on reservations (Japanese name first in Japanese text)
BOOKING_NAME=
BOOKING_NAME_KANA=
# Domestic format, e.g. 070-1234-5678 (converted to +81 for English text)
BOOKING_PHONE=
BOOKING_EMAIL=
# Optional. TableCheck books as a guest without these. For Google-login accounts
# use `npm run browser-login -- tabelog` instead of a password.
TABLECHECK_EMAIL=
TABLECHECK_PASSWORD=
TABELOG_EMAIL=
TABELOG_PASSWORD=

# 1 = never press the final confirm button / emails go to BOOKING_EMAIL instead of the restaurant
DRY_RUN=1
